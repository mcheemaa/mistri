# One MCP server connection: its own OAuth flow state, its tokens, and the
# bridge into agent tools. Rows with a manually supplied access_token (API
# key servers) work the same way without the OAuth columns.
class <%= class_name %> < ApplicationRecord
  encrypts :access_token, :refresh_token, :client_secret

  def self.mcp_allow_non_public = nil

  # Begin the OAuth flow: persists a pending connection and returns it with
  # the URL to send the user to.
  def self.connect(name:, url:, client_name:, redirect_uri:, scope: nil, issuer: nil)
    flow = Mistri::MCP::OAuth.start(url: url, client_name: client_name,
                                    redirect_uri: redirect_uri, scope: scope,
                                    issuer: issuer,
                                    allow_non_public: mcp_allow_non_public)
    connection = create!(name: name, url: url, status: "pending",
                         state: flow["state"], code_verifier: flow["code_verifier"],
                         client_id: flow["client_id"], client_secret: flow["client_secret"],
                         issuer: flow["issuer"],
                         token_auth_method: flow["token_auth_method"],
                         redirect_uri: flow["redirect_uri"])
    [connection, flow["authorize_url"]]
  end

  # Finish the flow from the OAuth callback. iss is the callback's iss
  # parameter, nil when it had none: pass params[:iss].
  def self.complete(state:, code:, iss:)
    connection = find_by!(state: state)
    tokens = Mistri::MCP::OAuth.complete(code: code, iss: iss,
                                         code_verifier: connection.code_verifier,
                                         client_id: connection.client_id,
                                         client_secret: connection.client_secret,
                                         issuer: connection.issuer,
                                         token_auth_method: connection.token_auth_method,
                                         resource: connection.url,
                                         redirect_uri: connection.redirect_uri,
                                         allow_non_public: mcp_allow_non_public)
    connection.update!(status: "connected", state: nil, code_verifier: nil,
                       access_token: tokens["access_token"],
                       refresh_token: tokens["refresh_token"],
                       expires_at: tokens["expires_at"], scope: tokens["scope"])
    connection
  end

  def client
    Mistri::MCP::Client.new(url: url, token: ->(refused: nil) { bearer_token(refused: refused) },
                            allow_non_public: self.class.mcp_allow_non_public)
  end

  def tools(**options)
    Mistri::MCP.tools(client, **options)
  end

  # A fresh bearer for every request; refreshes ahead of expiry, or when the
  # server refused the stored token, and persists the rotated refresh token.
  # A server retires a refresh token when it is used, so two refreshes at once
  # would lose the sign-in: the row is locked, and the second process finds
  # the first one's token there.
  def bearer_token(refused: nil)
    return access_token unless stale?(refused)

    with_lock { refresh! if stale?(refused) }
    access_token
  end

  def stale?(refused)
    return false if refresh_token.blank?
    return access_token == refused if refused

    expires_at.present? && expires_at <= 1.minute.from_now
  end

  def refresh!
    tokens = Mistri::MCP::OAuth.refresh(refresh_token: refresh_token,
                                        client_id: client_id, client_secret: client_secret,
                                        issuer: issuer, token_auth_method: token_auth_method,
                                        resource: url,
                                        allow_non_public: self.class.mcp_allow_non_public)
    update!(access_token: tokens["access_token"],
            refresh_token: tokens["refresh_token"] || refresh_token,
            expires_at: tokens["expires_at"], scope: tokens["scope"] || scope)
  end
end
